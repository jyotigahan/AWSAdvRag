# AWS General
AWS_REGION=us-east-1

# AWS Bedrock
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Amazon OpenSearch Serverless
OPENSEARCH_ENDPOINT=https://your-collection-id.us-east-1.aoss.amazonaws.com
OPENSEARCH_INDEX_NAME=rag-index

# S3
S3_BUCKET_NAME=rag-documents-xxxxxx
S3_PRESIGNED_EXPIRY=1800

# SQS
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/rag-doc-processing-xxxxxx

# Security
ACCESS_CONTROL_ENABLED=true
